# Copy this file to .env and replace every CHANGE_ME value.
# .env is ignored by Git: do not commit it.

# Application and database
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-orange-bonus-an80r1b5-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&stringtype=unspecified
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=npg_jB9aKS3XcDYN
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Authentication and email
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME
SPRING_MAIL_PASSWORD=CHANGE_ME
OCR_API_URL=https://CHANGE_ME

# vLLM services. Use distinct GPUs in production when available.
VLLM_IMAGE=vllm/vllm-openai:v0.27.0
# Base model recorded by adapter_config.json. Do not replace it with the GGUF file.
VLLM_GENERATION_MODEL=unsloth/Qwen3-4B-unsloth-bnb-4bit
# Absolute host directory containing adapter_model.safetensors, adapter_config.json,
# tokenizer files, and chat_template.jinja downloaded from Drive.
VLLM_LORA_ADAPTER_HOST_DIR=/models/qwen-local-adapter
VLLM_LORA_NAME=qwen-local
VLLM_LORA_ADAPTER_PATH=/models/qwen-local
VLLM_LORA_MAX_RANK=32
VLLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VLLM_GENERATION_GPU=0
VLLM_EMBEDDING_GPU=1
VLLM_GENERATION_MAX_MODEL_LEN=8192
VLLM_EMBEDDING_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.85
HF_TOKEN=


# Values consumed by the Spring backend and the RAG service.
AI_BASE_URL=http://vllm-generation:8000/v1
AI_EMBEDDING_BASE_URL=http://vllm-embeddings:8000/v1
AI_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
# The backend requests this adapter name; vLLM applies your trained LoRA weights.
AI_GENERATION_MODEL=qwen-local
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AI_REQUEST_TIMEOUT_SECONDS=120
